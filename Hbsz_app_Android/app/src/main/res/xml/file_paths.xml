<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 暴露路径（版本自更新专用）：
     external-files-path 对应 getExternalFilesDir(null) 根（update/ 子目录在其下）；
     cache-path 兜底（无外部存储时 APK 落 cacheDir/update）。 -->
<paths>
    <external-files-path name="update" path="update/" />
    <cache-path name="update_cache" path="update/" />
</paths>
