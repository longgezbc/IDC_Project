<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.hbsz_idc_system_end.mapper.SysRolePermissionMapper">

    <!-- 【修复M7】批量插入角色权限关联，替代 Service 中循环单条 insert。
         created_at 由数据库默认值填充（与原单条 insert 行为一致）。 -->
    <insert id="batchInsert">
        INSERT INTO sys_role_permission (role_id, permission_id) VALUES
        <foreach collection="permissionIds" item="permId" separator=",">
            (#{roleId}, #{permId})
        </foreach>
    </insert>

</mapper>
