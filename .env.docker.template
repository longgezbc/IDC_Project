# ============================================================================
# HBSZ Docker Compose 环境变量模板
# 使用：复制为 .env.docker（或 .env.<环境名>）并填入实际值
# 命令：docker compose --env-file .env.docker up -d
#       或用部署脚本：./scripts/deploy.sh --branch main --env-file .env.docker
# ----------------------------------------------------------------------------
# ⚠ 生产环境务必使用强密码，勿用 123456 / 默认值 / CHANGE_ME
#   生成强密码：   openssl rand -base64 32
#   生成 JWT 密钥：openssl rand -base64 64
# ============================================================================

# ---- MySQL 数据库 ----
MYSQL_ROOT_PASSWORD=__改成强密码_openssl_rand_base64_32__
MYSQL_DATABASE=hbsz_idc_system
MYSQL_PORT=3306

# ---- Redis 缓存 ----
REDIS_PASSWORD=__改成强密码_openssl_rand_base64_32__
REDIS_PORT=6379

# ---- 后端服务 ----
BACKEND_PORT=8080
# 应用运行时数据库账号（仅 DML，最小权限，账号分离方案 P1-2）
DB_USERNAME=hbsz_app
DB_PASSWORD=__改成强密码_openssl_rand_base64_32__
# Flyway 迁移账号密码（hbsz_migrate 使用，持 DDL+SYSTEM_USER，与 DB_PASSWORD 不同）
FLYWAY_PASSWORD=__改成强密码_openssl_rand_base64_32__
# JWT 签名密钥（必须改！openssl rand -base64 64）
JWT_SECRET=__改成_openssl_rand_base64_64_生成的强密钥__

# ---- 前端服务 ----
FRONTEND_PORT=80
# CORS 白名单域名（生产环境改为实际域名，逗号分隔，禁止用 *）
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ---- 可选：受信反向代理白名单（部署在 Nginx/SLB 后时配置代理 IP/CIDR，逗号分隔）----
# 留空则限流/审计按 TCP 直连 IP 计数；配置后采信 X-Forwarded-For 取真实客户端 IP
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2
